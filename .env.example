# LLM provider: "auto" (Claude if ANTHROPIC_API_KEY set, else offline fallback),
# "anthropic" (fail hard if no key), or "fallback" (fully offline, deterministic).
DPA_LLM_PROVIDER=auto

# Claude API — used for the reasoning/recommendation node only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# SAP connectivity: leave empty to use the in-memory mock dataset,
# or point at the mock OData-style server itself (same app) for end-to-end HTTP mode.
SAP_ODATA_BASE_URL=

# Append-only decision audit log (JSONL).
AUDIT_LOG_PATH=audit/decisions.jsonl
