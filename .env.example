# LLM provider: "auto" (Claude if ANTHROPIC_API_KEY set, else offline fallback),
# "anthropic" (fail hard if no key), or "fallback" (fully offline, deterministic).
DPA_LLM_PROVIDER=auto

# Claude API — used for the reasoning/recommendation node only.
ANTHROPIC_API_KEY=
# Confirm the current model id in Anthropic's docs; this is only the default.
ANTHROPIC_MODEL=claude-sonnet-5-5

# SAP connectivity: leave empty to use the in-memory mock dataset, or start the bundled
# OData-style mock server (python -m dpa_agent.sap.mock_odata --port 8090) and point at it:
# SAP_ODATA_BASE_URL=http://localhost:8090/odata
SAP_ODATA_BASE_URL=

# Hash-chained decision audit log (JSONL).
AUDIT_LOG_PATH=audit/decisions.jsonl
